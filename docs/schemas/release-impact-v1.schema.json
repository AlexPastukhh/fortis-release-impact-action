{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexPastukhh/fortis-container/blob/main/docs/schemas/release-impact-v1.schema.json",
  "title": "Fortis Pull Request Release Impact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "releaseImpact"
  ],
  "properties": {
    "releaseImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "classification",
        "reason",
        "targets",
        "dependencies",
        "verification"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "classification": {
          "enum": [
            "deployment",
            "no-deployment",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "targets": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "actions"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,99}$"
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "image-rebuild",
                    "config-deploy",
                    "windows-update",
                    "package-build",
                    "migration-required",
                    "unknown"
                  ]
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pullRequests",
            "targets"
          ],
          "properties": {
            "pullRequests": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository",
                  "number"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  }
                }
              }
            },
            "targets": {
              "type": "array",
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository",
                  "target"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,99}$"
                  }
                }
              }
            }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "deployment"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": {
                "const": "no-deployment"
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "targets": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
