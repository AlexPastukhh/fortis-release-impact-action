{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexPastukhh/fortis-container/blob/main/docs/schemas/build-target-catalog-v1.schema.json",
  "title": "Fortis Build Target Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "buildUnits",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
    },
    "buildUnits": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "artifactType",
          "inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$"
          },
          "artifactType": {
            "enum": [
              "docker-image",
              "windows-package",
              "application-package",
              "archive"
            ]
          },
          "recipe": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 120,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "deployment",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$"
          },
          "buildUnit": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$"
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 120,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "deployment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "procedure",
              "environments"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "docker-compose-service",
                  "owner-controlled",
                  "windows-source",
                  "windows-application",
                  "configuration",
                  "package",
                  "none"
                ]
              },
              "procedure": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "environments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,99}$"
                }
              },
              "services": {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 30,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,99}$"
                }
              }
            }
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "target"
              ],
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
                },
                "target": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,99}$"
                }
              }
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "noDeploymentPaths": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  }
}
